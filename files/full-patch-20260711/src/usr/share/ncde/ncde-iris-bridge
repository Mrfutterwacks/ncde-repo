#!/usr/bin/env python3
# ncde-iris-bridge — carries the Iris palette to the two things outside the shell
# that draw their own colours: GTK apps and dunst's notification cards (2026-09-25).
#
# Why this exists: gtk-3.0/_palette-*.css promise "the engine rewrites these LIVE on
# every Iris Chroma click", but NCDEEngine (C++, no source) only ever rewrites
# _accent.css — with a stale wallpaper accent — so Thunar, GIMP and LibreOffice sat
# on the July teal defaults. And dunst ran the stock /etc/dunst/dunstrc (grey
# #222222, Monospace 8); NCDE's Notifications > Position was never applied to it.
#
# main.qml writes the live tokens to ~/.config/ncde/iris-bridge.json whenever the
# palette, the wallpaper ink, the fonts, Script Shift or the notification position
# change, then launches this. It writes:
#   ~/.themes/NCDE/gtk-3.0/_palette-{dark,light}.css + _accent.css
#   ~/.config/gtk-4.0/_palette-{dark,light}.css + _accent.css  (defines only)
#   ~/.config/dunst/dunstrc — the operator's Mucha card (parchment, gilt frame,
#     Cinzel Decorative title between fleurons, Cormorant italic body), every
#     colour re-made from the palette: the design's own lightness and chroma, the
#     palette's hues (gold <- gilt3, sage <- verd, wine <- wine4, blush <- accent).
#     A dunstrc the user wrote themselves is never overwritten: then the colours go
#     in dunstrc.d/50-ncde-iris.conf instead.
# Files are only rewritten when their content changes; dunst reloads live, GTK apps
# pick the palette up the next time they start.

import fcntl, json, math, os, re, subprocess, sys

HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config", "ncde", "iris-bridge.json")
GTK3 = os.path.join(HOME, ".themes", "NCDE", "gtk-3.0")
GTK4 = os.path.join(HOME, ".config", "gtk-4.0")
DUNST_DIR = os.path.join(HOME, ".config", "dunst")
MARK = "# NCDE — generated by ncde-iris-bridge from the Iris palette."


def log(*a):
    print("[iris-bridge]", *a, file=sys.stderr, flush=True)


# ── colour (sRGB <-> CIE Lab/LCh, D65), same maths as ncde-color.js ──────────
def parse(h):
    h = (h or "").strip().lstrip("#")
    if len(h) == 8:            # Qt's #AARRGGBB
        h = h[2:]
    if len(h) != 6 or not re.fullmatch(r"[0-9a-fA-F]{6}", h):
        return None
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def hexc(rgb):
    return "#%02x%02x%02x" % tuple(round(min(1, max(0, v)) * 255) for v in rgb)


def _lin(c): return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
def _gam(c): return 12.92 * c if c <= 0.0031308 else 1.055 * max(c, 0) ** (1 / 2.4) - 0.055
def _f(t):   return t ** (1 / 3) if t > 0.008856 else 7.787 * t + 16 / 116
def _fi(t):  return t ** 3 if t > 0.206893 else (t - 16 / 116) / 7.787


def lch(rgb):
    r, g, b = map(_lin, rgb)
    x = (0.4124 * r + 0.3576 * g + 0.1805 * b) / 0.95047
    y = 0.2126 * r + 0.7152 * g + 0.0722 * b
    z = (0.0193 * r + 0.1192 * g + 0.9505 * b) / 1.08883
    L = 116 * _f(y) - 16
    A = 500 * (_f(x) - _f(y))
    B = 200 * (_f(y) - _f(z))
    return L, math.hypot(A, B), math.degrees(math.atan2(B, A)) % 360


def _rgb_of(L, C, h):
    A, B = C * math.cos(math.radians(h)), C * math.sin(math.radians(h))
    fy = (L + 16) / 116
    x, y, z = _fi(fy + A / 500) * 0.95047, _fi(fy), _fi(fy - B / 200) * 1.08883
    r = 3.2406 * x - 1.5372 * y - 0.4986 * z
    g = -0.9689 * x + 1.8758 * y + 0.0415 * z
    b = 0.0557 * x - 0.2040 * y + 1.0570 * z
    return tuple(map(_gam, (r, g, b)))


def from_lch(L, C, h):
    """LCh -> hex; chroma pulled in until the colour fits sRGB (hue + L kept)."""
    while C > 0:
        o = _rgb_of(L, C, h)
        if all(-0.001 <= v <= 1.001 for v in o):
            return hexc(o)
        C -= 0.5
    return hexc(_rgb_of(L, 0, h))


def lum(rgb):
    r, g, b = map(_lin, rgb)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    la, lb = lum(a), lum(b)
    return (max(la, lb) + 0.05) / (min(la, lb) + 0.05)


def mix(a, b, t):
    return tuple(a[i] + (b[i] - a[i]) * t for i in range(3))


def readable(fg, bg, need):
    """fg nudged toward white or black (whichever bg favours) until it reaches `need`:1."""
    if contrast(fg, bg) >= need:
        return fg
    to = (1, 1, 1) if contrast((1, 1, 1), bg) >= contrast((0, 0, 0), bg) else (0, 0, 0)
    for i in range(1, 21):
        c = mix(fg, to, i / 20)
        if contrast(c, bg) >= need:
            return c
    return to


# ── writers ─────────────────────────────────────────────────────────────────
def put(path, text):
    """Write only when the content changed. Returns True when it did."""
    try:
        with open(path, encoding="utf-8") as f:
            if f.read() == text:
                return False
    except OSError:
        pass
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)
    return True


def gtk_tokens(t):
    bg = parse(t.get("panelBg")) or (0.15, 0.19, 0.2)
    base = parse(t.get("surface")) or bg
    alt = parse(t.get("surfaceAlt")) or base
    pop = parse(t.get("popupBg")) or bg
    border = parse(t.get("border")) or mix(bg, (1, 1, 1), 0.3)
    ink = parse(t.get("text")) or (0.9, 0.9, 0.9)
    acc = parse(t.get("accent")) or (0.5, 0.4, 0.3)
    fg = readable(ink, bg, 7.0)
    text = readable(ink, base, 7.0)
    soft = readable(mix(fg, bg, 0.42), bg, 3.0)
    sel_fg = (1, 1, 1) if contrast((1, 1, 1), acc) >= contrast((0, 0, 0), acc) else (0, 0, 0)
    gold = parse(t.get("gilt3")) or (0.83, 0.63, 0.23)
    wine = parse(t.get("wine4")) or (0.75, 0.22, 0.17)
    verd = parse(t.get("verd")) or (0.29, 0.6, 0.42)
    return {
        "bg": hexc(bg), "fg": hexc(fg), "base": hexc(base), "text": hexc(text),
        "soft": hexc(soft), "border": hexc(border), "head": hexc(mix(bg, alt, 0.5)),
        "tip": hexc(pop), "tipfg": hexc(readable(ink, pop, 7.0)),
        "acc": hexc(acc), "selfg": hexc(sel_fg),
        "warn": hexc(readable(gold, bg, 3.0)), "err": hexc(readable(wine, bg, 3.0)),
        "ok": hexc(readable(verd, bg, 3.0)),
    }


def gtk3_palette(c, mode):
    return f"""/* NCDE GTK3 — {mode} grounds. Written by ncde-iris-bridge from the live Iris
   tokens on every palette change (panelBg/surface/ink/border + gilt/wine/verd).
   NO Adwaita import — NCDE ships its own complete widget styling in _rules.css. */

@define-color theme_bg_color            {c['bg']};  /* ← panelBg  */
@define-color theme_fg_color            {c['fg']};  /* ← ink      */
@define-color theme_base_color          {c['base']};  /* ← surface  */
@define-color theme_text_color          {c['text']};  /* ← ink      */
@define-color content_view_bg           {c['base']};  /* ← surface  */
@define-color text_view_bg              {c['base']};  /* ← surface  */
@define-color insensitive_bg_color      {c['bg']};  /* ← panelBg  */
@define-color insensitive_fg_color      {c['soft']};  /* ← inkSoft  */
@define-color insensitive_base_color    {c['base']};  /* ← surface  */
@define-color theme_unfocused_bg_color   {c['bg']}; /* ← panelBg  */
@define-color theme_unfocused_fg_color   {c['soft']}; /* ← inkSoft  */
@define-color theme_unfocused_base_color {c['base']}; /* ← surface  */
@define-color theme_unfocused_text_color {c['text']}; /* ← ink      */
@define-color borders                    {c['border']}; /* ← border   */
@define-color unfocused_borders          {c['border']}; /* ← border   */
@define-color theme_selected_fg_color            {c['selfg']};
@define-color theme_unfocused_selected_fg_color  {c['selfg']};

@define-color tooltip_bg_color  {c['tip']};  /* ← popupBg */
@define-color tooltip_fg_color  {c['tipfg']};
@define-color warning_color     {c['warn']};  /* ← gilt3 */
@define-color error_color       {c['err']};  /* ← wine4 */
@define-color success_color     {c['ok']};  /* ← verd  */
"""


def gtk4_palette(c, mode):
    return f"""/* NCDE GTK4 — {mode} grounds. DEFINES ONLY (no Adwaita import, no rules — those
   corrupt libadwaita). Written by ncde-iris-bridge from the live Iris tokens. */
@define-color theme_bg_color         {c['bg']};  /* ← panelBg */
@define-color theme_fg_color         {c['fg']};  /* ← ink     */
@define-color theme_base_color       {c['base']};  /* ← surface */
@define-color theme_text_color       {c['text']};  /* ← ink     */
@define-color insensitive_bg_color   {c['bg']};  /* ← panelBg */
@define-color insensitive_fg_color   {c['soft']};  /* ← inkSoft */
@define-color borders                {c['border']};  /* ← border  */
@define-color theme_selected_fg_color {c['selfg']};

/* libadwaita compat named colors (consumed by adw apps that read them) */
@define-color window_bg_color        {c['bg']};
@define-color window_fg_color        {c['fg']};
@define-color view_bg_color          {c['base']};
@define-color view_fg_color          {c['text']};
@define-color headerbar_bg_color     {c['head']};
@define-color headerbar_fg_color     {c['fg']};
@define-color card_bg_color          {c['base']};
@define-color card_fg_color          {c['text']};
@define-color popover_bg_color       {c['tip']};
@define-color popover_fg_color       {c['tipfg']};
@define-color accent_bg_color        {c['acc']};
@define-color accent_fg_color        {c['selfg']};
@define-color warning_color          {c['warn']};
@define-color error_color            {c['err']};
@define-color success_color          {c['ok']};
"""


def gtk_accent(c):
    return ("/* NCDE — Iris accent, written by ncde-iris-bridge (the shell's own accent). */\n"
            f"@define-color ncde_accent {c['acc']};\n"
            "@define-color theme_selected_bg_color @ncde_accent;\n")


def write_gtk(t):
    c = gtk_tokens(t)
    n = 0
    for d, pal in ((GTK3, gtk3_palette), (GTK4, gtk4_palette)):
        if not os.path.isdir(d):
            continue
        n += put(os.path.join(d, "_palette-dark.css"), pal(c, "dark"))
        n += put(os.path.join(d, "_palette-light.css"), pal(c, "light"))
        n += put(os.path.join(d, "_accent.css"), gtk_accent(c))
    return n


# ── dunst: the operator's Mucha card, hued by the palette ───────────────────
def hue_of(t, key, fallback_h, ref_c):
    """(hue, chroma factor) of a palette token. The factor scales the design's
    chroma so a cold, quiet palette gets quiet cards instead of fixed warm gold."""
    rgb = parse(t.get(key))
    if not rgb:
        return fallback_h, 1.0
    _, C, h = lch(rgb)
    if C < 3:                                   # grey token: no hue to speak of
        return fallback_h, 0.2
    return h, min(1.1, max(0.25, C / ref_c))


def fonts_have(family):
    try:
        out = subprocess.run(["fc-list", family, "family"], capture_output=True,
                             text=True, timeout=5).stdout
        return bool(out.strip())
    except Exception:
        return False


def dunst_card(t):
    hG, kG = hue_of(t, "gilt3", 80, 45)       # gold: frame, title, parchment
    hV, kV = hue_of(t, "verd", 127, 30)       # sage: low urgency
    hW, kW = hue_of(t, "wine4", 10, 40)       # wine: critical ground
    hA, kA = hue_of(t, "accent", 46, 35)      # blush end of the progress gradient
    g = lambda L, C: from_lch(L, C * kG, hG)
    v = lambda L, C: from_lch(L, C * kV, hV)
    w = lambda L, C: from_lch(L, C * kW, hW)
    a = lambda L, C: from_lch(L, C * kA, hA)

    # the design's own lightness/chroma (measured from the operator's hexes)
    col = {
        "frame": g(60.2, 48.9), "title": g(37.3, 35.8),
        "bg": g(91.9, 16.1), "fg": g(19.0, 15.8), "hi": g(68.6, 50.3), "hi2": a(66.0, 36.5),
        "lbg": g(91.4, 12.2), "lfg": v(36.7, 14.4), "lframe": v(64.5, 24.0), "lhi2": g(74.7, 32.4),
        "cbg": w(22.5, 26.5), "cfg": g(90.5, 16.8), "cframe": g(75.6, 52.3), "ctitle": g(84.4, 40.5),
    }

    scale = 1.25                                  # Script Shift, the one text dial
    try:
        with open(os.path.join(HOME, ".config", "ncde", "fonts.json"), encoding="utf-8") as f:
            scale = float(json.load(f).get("fontSizeScale") or 1.25)
    except (OSError, ValueError, TypeError):
        pass
    body_pt = max(9, round(12 * scale / 1.25))   # the design was drawn at Script Shift 1.25
    title_pt = max(8, round(11 * scale / 1.25))
    body = t.get("bodyFont") or "Cormorant Garamond"
    title = t.get("titleFont") or "Cinzel"
    if fonts_have(title + " Decorative"):
        title += " Decorative"                   # Cinzel -> Cinzel Decorative, as designed

    pos = t.get("notifPosition", 1)
    top, bot, dock = int(t.get("topH") or 28), int(t.get("bottomH") or 28), int(t.get("dockW") or 64)
    if pos == 0:
        origin, offset = "top-left", (8 + dock + 20, top + 20)
    elif pos == 2:
        origin, offset = "bottom-right", (28, bot + 20)
    else:
        origin, offset = "top-right", (28, top + 20)

    def fmt(color, left, right):
        return (f"\"<span font_desc='{title} Bold {title_pt}' foreground='{color}' letter_spacing='1200'>"
                f"{left}  %s  {right}</span>\\n<span font_desc='{body} Italic {body_pt}'>%b</span>\"")

    colours = f"""[global]
    origin = {origin}
    offset = ({offset[0]}, {offset[1]})
    frame_color = "{col['frame']}"
    font = "{body} {body_pt}"
    format = {fmt(col['title'], '❧', '❦')}

[urgency_low]
    background = "{col['lbg']}"
    foreground = "{col['lfg']}"
    frame_color = "{col['lframe']}"
    highlight = "{col['lframe']}, {col['lhi2']}"

[urgency_normal]
    background = "{col['bg']}"
    foreground = "{col['fg']}"
    frame_color = "{col['frame']}"
    highlight = "{col['hi']}, {col['hi2']}"

[urgency_critical]
    background = "{col['cbg']}"
    foreground = "{col['cfg']}"
    frame_color = "{col['cframe']}"
    highlight = "{col['cframe']}, {col['ctitle']}"
    format = {fmt(col['ctitle'], '✥', '✥')}
"""
    return colours


# the operator's card (Downloads/dunstrc, 2026-09-25) minus its colours, which
# dunst_card() supplies from the palette
CARD_BASE = """[global]
    monitor = 0
    follow = mouse
    width = (320, 420)
    height = (0, 260)
    notification_limit = 5
    gap_size = 14
    corner_radius = 18
    frame_width = 3
    separator_height = 2
    separator_color = frame
    padding = 16
    horizontal_padding = 22
    text_icon_padding = 18
    icon_position = left
    min_icon_size = 48
    max_icon_size = 64
    icon_corner_radius = 32
    enable_recursive_icon_lookup = true
    icon_theme = {icon_theme}
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 180
    progress_bar_max_width = 320
    progress_bar_corner_radius = 4
    markup = full
    line_height = 2
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = end
    ignore_newline = no
    show_age_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    transparency = 0
    browser = /usr/bin/xdg-open
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    timeout = 6

[urgency_normal]
    timeout = 10

[urgency_critical]
    timeout = 0

"""


def icon_theme():
    """The desktop's icon theme (GTK settings.ini), so card icons match the apps."""
    try:
        with open(os.path.join(HOME, ".config", "gtk-3.0", "settings.ini"), encoding="utf-8") as f:
            m = re.search(r"^gtk-icon-theme-name\s*=\s*(.+)$", f.read(), re.M)
            if m:
                return m.group(1).strip()
    except OSError:
        pass
    return "Adwaita"


def write_dunst(t):
    os.makedirs(DUNST_DIR, exist_ok=True)
    base = os.path.join(DUNST_DIR, "dunstrc")
    colours = dunst_card(t)
    mine = True
    try:
        with open(base, encoding="utf-8") as f:
            mine = f.readline().rstrip("\n") == MARK
    except OSError:
        pass                                   # no user dunstrc yet: ours to write
    header = (MARK + "\n# Rewritten on every Iris palette change — your own tweaks go in\n"
              "# ~/.config/dunst/dunstrc.d/*.conf (they override this file).\n"
              "# Design: the operator's Mucha card (parchment, gilt frame, fleurons).\n\n")
    if mine:
        # dunst merges repeated sections in file order: the palette block comes
        # second, so its colours and position win over the base
        return put(base, header + CARD_BASE.replace("{icon_theme}", icon_theme())
                   + "# ── from the Iris palette ──\n" + colours)
    d = os.path.join(DUNST_DIR, "dunstrc.d")
    os.makedirs(d, exist_ok=True)
    return put(os.path.join(d, "50-ncde-iris.conf"), MARK + "\n\n" + colours)


def main():
    lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "ncde-iris-bridge.lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        with open(CONF, encoding="utf-8") as f:
            t = json.loads(f.read())
    except (OSError, ValueError) as e:
        log("no tokens yet:", e)
        return 0
    n = write_gtk(t)
    changed = write_dunst(t)
    if changed:
        subprocess.run(["dunstctl", "reload"], capture_output=True, timeout=5)
    log(f"accent {t.get('accent')}: gtk files rewritten {n}, dunst {'reloaded' if changed else 'unchanged'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
