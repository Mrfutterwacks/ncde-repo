[Unit]
Description=NCDE Portal — native X11 login manager
Documentation=file:///usr/share/ncde/portal/README.md
Conflicts=getty@tty1.service
After=systemd-user-sessions.service getty@tty1.service plymouth-quit.service
After=rc-local.service

[Service]
Type=simple
# The root daemon: it owns tty1, starts Xorg on tty1/:0, runs the greeter as the
# unprivileged ncde-portal user, drives the PAM helper, and launches the session.
# PREREQUISITE: the greeter user must exist, or spawnGreeter() fails and the unit
# restart-loops:
#   useradd --system --home-dir /var/lib/ncde-portal --create-home \
#           --shell /usr/sbin/nologin ncde-portal
ExecStart=/usr/bin/ncde-portal --daemon --vt vt01 --display :0 --greeter-user ncde-portal
Restart=always
RestartSec=1
# Must own a real VT as root to start X and call PAM.
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
Alias=display-manager.service
