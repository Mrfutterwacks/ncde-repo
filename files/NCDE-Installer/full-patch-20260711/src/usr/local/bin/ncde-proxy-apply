#!/usr/bin/env python3
"""ncde-proxy-apply — apply the Settings panel's saved proxy so it takes effect.

The Settings panel (NetworkTab.qml) writes proxyEnabled/proxyHost/proxyPort to
~/.config/ncde/network.json, but nothing ever APPLIED it (the settings persisted
and did nothing — the G10 defect). This helper reads that file and applies the
proxy the standard, app-wide ways, WITHOUT touching any NCDE binary:

  * gsettings org.gnome.system.proxy  — GTK apps, Chromium, and the portal honor it
  * ~/.config/environment.d/ncde-proxy.conf — http_proxy/https_proxy for the
    session env (curl/wget/pacman-via-env and Qt apps that read the env)

Runs at login and whenever network.json changes (a user systemd path unit fires
it). Disabling the proxy clears both. Idempotent; degrades quietly if gsettings
isn't present. Never fails the session.
"""
import json
import os
import subprocess
import sys

CFG = os.path.expanduser("~/.config/ncde/network.json")
ENVD = os.path.expanduser("~/.config/environment.d")
ENVFILE = os.path.join(ENVD, "ncde-proxy.conf")
GS_SCHEMA = "org.gnome.system.proxy"


def _gsettings(*args):
    try:
        subprocess.run(["gsettings", *args], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        pass  # no gsettings on this host — env file still covers CLI/Qt


def _read_cfg():
    try:
        with open(CFG) as f:
            d = json.load(f)
        if isinstance(d, dict):
            return d
    except (OSError, ValueError):
        pass
    return {}


def apply(cfg):
    enabled = bool(cfg.get("proxyEnabled", False))
    host = str(cfg.get("proxyHost", "") or "").strip()
    port = cfg.get("proxyPort", 8080)
    try:
        port = int(port)
    except (TypeError, ValueError):
        port = 8080

    os.makedirs(ENVD, exist_ok=True)

    if enabled and host:
        url = "http://%s:%d" % (host, port)
        _gsettings("set", GS_SCHEMA, "mode", "manual")
        for leg in ("http", "https"):
            _gsettings("set", "%s.%s" % (GS_SCHEMA, leg), "host", host)
            _gsettings("set", "%s.%s" % (GS_SCHEMA, leg), "port", str(port))
        # env for the session (loaded by systemd user env at next login; written now)
        with open(ENVFILE, "w") as f:
            f.write("# generated by ncde-proxy-apply — do not edit\n")
            for k in ("http_proxy", "https_proxy", "HTTP_PROXY", "HTTPS_PROXY"):
                f.write("%s=%s\n" % (k, url))
        return "applied %s" % url
    else:
        _gsettings("set", GS_SCHEMA, "mode", "none")
        try:
            if os.path.exists(ENVFILE):
                # never delete — empty it, leaving a clear record (never-delete rule)
                with open(ENVFILE, "w") as f:
                    f.write("# ncde-proxy-apply: proxy disabled\n")
        except OSError:
            pass
        return "cleared (proxy disabled)"


def main():
    result = apply(_read_cfg())
    sys.stderr.write("[ncde-proxy-apply] %s\n" % result)
    return 0


if __name__ == "__main__":
    sys.exit(main())
