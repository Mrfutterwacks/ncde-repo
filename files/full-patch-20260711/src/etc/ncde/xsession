#!/bin/sh
# /etc/ncde/xsession — the one trusted entry point the PAM helper execs (as the
# authenticated user, after pam_open_session). Sets up the standard X session
# environment, then execs whatever argument it was handed, defaulting to NCDE's
# session. The exec chain stays unbroken so the session's exit is the logout.
[ -f /etc/profile ]      && . /etc/profile
[ -f "$HOME/.profile" ]  && . "$HOME/.profile"
[ -f "$HOME/.xprofile" ] && . "$HOME/.xprofile"
[ -f /etc/X11/Xresources ] && xrdb -merge /etc/X11/Xresources
if [ -d /etc/X11/xinit/xinitrc.d ]; then
    for f in /etc/X11/xinit/xinitrc.d/?*.sh; do [ -x "$f" ] && . "$f"; done
fi
[ "$#" -eq 0 ] && set -- /usr/local/bin/ncde-x11-session
exec "$@"
