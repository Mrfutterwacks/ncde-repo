[Unit]
Description=VerdantFolio (GiGi) helper — advice library + LibreOffice + Hummingbird hand-off
After=network.target

[Service]
WorkingDirectory=/usr/lib/ncde/verdantfolio
ExecStart=/usr/bin/python3 /usr/lib/ncde/verdantfolio/verdant_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
